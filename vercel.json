{
  "version": 2,
  "builds": [
    {
      "src": "api/health-check.js",
      "use": "@vercel/node"
    },
    {
      "src": "*(index.html|logo.png|favicon.png)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health-check",
      "dest": "/api/health-check.js"
    },
    {
      "src": "/logo.png",
      "dest": "/logo.png"
    },
    {
      "src": "/favicon.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
